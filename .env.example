# ==============================================================================
# Local-First Budget Tracker — Environment Configuration Template
# Copy this file to `.env` to override defaults locally:
#   cp .env.example .env
# ==============================================================================

# Local SQLite database path used by the macOS CLI and statement tools
BUDGET_DB_PATH=budget_tracker.sqlite

# Local Ollama server endpoint and model for offline AI merchant categorization
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# iOS App Bundle Identifier (used for booted iOS Simulator 2-way database sync)
IOS_BUNDLE_ID=com.localfirst.BudgetTracker
